{
  "name": "Social Media Auto Publisher - Mehdi Habibzadeh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerTimes": {
                "item": [
                  {
                    "hour": 11,
                    "minute": 30
                  },
                  {
                    "hour": 17,
                    "minute": 30
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        -460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "select",
        "table": "scheduled_posts",
        "limit": 1,
        "where": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict"
            },
            "conditions": [
              {
                "id": "published_condition",
                "left": "published",
                "right": "false"
              },
              {
                "id": "scheduled_time_condition",
                "left": "scheduled_for",
                "operator": "before",
                "right": "={{ $now.toISO() }}"
              }
            ],
            "combinator": "and"
          }
        }
      },
      "id": "2",
      "name": "Get Next Scheduled Post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        -240,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "2",
          "name": "Neon PostgreSQL account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has_post_condition",
              "left": "={{ $input.item.length }}",
              "right": 1,
              "operator": "gte"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3",
      "name": "Post Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -20,
        300
      ]
    },
    {
      "parameters": {
        "text": "={{ $json.content_linkedin }}",
        "attachments": "={{ $json.image_url ? $json.image_url : undefined }}"
      },
      "id": "4",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "credentials": {
